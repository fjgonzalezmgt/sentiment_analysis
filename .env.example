# Copia este archivo como .env y completa solo los valores necesarios.
OPENAI_API_KEY=

# Clasificación de alto volumen. Alternativas: gpt-5.6-terra, gpt-5.6-sol.
OPENAI_CLASSIFICATION_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=256
OPENAI_MAX_RETRIES=5
OPENAI_TIMEOUT_SECONDS=60

# Embeddings y almacenamiento local.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=chroma_data
CHROMA_COLLECTION=customer_reviews
CHROMA_UPSERT_BATCH_SIZE=100

# Para una instancia Chroma en modo servidor, descomenta:
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# CHROMA_SSL=false
